{
  "name": "devtrace",
  "displayName": "DevTrace",
  "description": "Capture Cursor and Qoder agent memory into a local database",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "haiyongchen",
  "icon": "media/devtrace-logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devtrace",
          "title": "DevTrace",
          "icon": "media/devtrace-logo.png"
        }
      ]
    },
    "views": {
      "devtrace": [
        {
          "type": "webview",
          "id": "devtrace.home",
          "name": "当前项目"
        }
      ]
    },
    "commands": [
      {
        "command": "devtrace.pause",
        "title": "DevTrace: Pause Collection"
      },
      {
        "command": "devtrace.resume",
        "title": "DevTrace: Resume Collection"
      },
      {
        "command": "devtrace.deleteProject",
        "title": "DevTrace: Delete Memory For This Workspace"
      },
      {
        "command": "devtrace.resetMemory",
        "title": "DevTrace: Clear Memory and Reimport"
      },
      {
        "command": "devtrace.configureMcp",
        "title": "DevTrace: Configure MCP"
      },
      {
        "command": "devtrace.query",
        "title": "DevTrace: Query Current Project"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
